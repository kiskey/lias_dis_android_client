<?xml version="1.0" encoding="utf-8"?>

<!--
====================================================================
File: app/src/main/AndroidManifest.xml
Version: 24.0.0

Integrated contracts:
  - Launcher Activity
  - singleTop for onNewIntent()
  - LIAS Remote navigation deep links
  - no server/token deep-link configuration contract
  - network permissions
  - existing local-network HTTP compatibility
====================================================================
-->

<manifest
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission
        android:name="android.permission.INTERNET" />

    <uses-permission
        android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name=".LiasApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="LIAS Remote"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.LiasRemote"
        android:usesCleartextTraffic="true"
        tools:targetApi="35">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.LiasRemote"
            android:windowSoftInputMode="adjustResize">

            <!-- Standard launcher. -->
            <intent-filter>

                <action
                    android:name="android.intent.action.MAIN" />

                <category
                    android:name="android.intent.category.LAUNCHER" />

            </intent-filter>

            <!--
                Navigation-only deep links.

                Supported examples:

                  liasremote://home
                  liasremote://devices
                  liasremote://devices/<pdid>
                  liasremote://device/<pdid>
                  liasremote://schedules
                  liasremote://rules
                  liasremote://settings

                LiasDeepLinks performs path validation.

                No URI route is provided for:
                  - changing server
                  - setting auth token
                  - importing credentials
            -->
            <intent-filter>

                <action
                    android:name="android.intent.action.VIEW" />

                <category
                    android:name="android.intent.category.DEFAULT" />

                <category
                    android:name="android.intent.category.BROWSABLE" />

                <data
                    android:scheme="liasremote" />

            </intent-filter>

        </activity>

    </application>

</manifest>
