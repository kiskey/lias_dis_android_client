<!-- ==================================================================== -->
<!-- File: app/src/main/res/xml/network_security_config.xml                -->
<!-- Version: 1.2.0                                                       -->
<!-- Audit Fixes:                                                         -->
<!--   1. Replaced invalid <domain> tags with a <base-config> to safely    -->
<!--      allow cleartext HTTP for all private LAN IPs and localhost.      -->
<!-- ==================================================================== -->

<network-security-config>
    <!-- FIX 2.1: Base config permits cleartext for LAN management apps -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <!-- Trust user added CAs for self-signed local HTTPS servers -->
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
