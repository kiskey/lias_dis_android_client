<!-- ==================================================================== -->
<!-- File: app/src/main/res/xml/network_security_config.xml                -->
<!-- Version: 1.0.0                                                       -->
<!-- Purpose: Allows cleartext HTTP traffic ONLY for private LAN IPs and   -->
<!--          .local domains. Enforces HTTPS for all public internet       -->
<!-- traffic, maintaining security while supporting local LIAS servers.   -->
<!-- ==================================================================== -->

<network-security-config>
    <!-- Default configuration for all other traffic (enforce TLS) -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    
    <!-- Domain-specific configuration for local network access -->
    <domain-config cleartextTrafficPermitted="true">
        <!-- Loopback -->
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        
        <!-- Private IP Ranges (RFC 1918) -->
        <domain includeSubdomains="false">10.0.0.0</domain>
        <domain includeSubdomains="true">10.in-addr.arpa</domain>
        <domain includeSubdomains="false">192.168.0.0</domain>
        <domain includeSubdomains="true">192.168.in-addr.arpa</domain>
        <domain includeSubdomains="false">172.16.0.0</domain>
        <domain includeSubdomains="true">172.16.in-addr.arpa</domain>
        
        <!-- mDNS / Localhost domains -->
        <domain includeSubdomains="true">local</domain>
    </domain-config>
</network-security-config>
