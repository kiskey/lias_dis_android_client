<!-- ==================================================================== -->
<!-- File: app/src/main/res/values/themes.xml                              -->
<!-- Version: 1.0.0                                                       -->
<!-- Purpose: Base Android XML theme. Prevents white flash on cold start  -->
<!--          by matching the Compose background color before UI inflation.-->
<!-- ==================================================================== -->

<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.LiasRemote" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/background_light</item>
        <item name="android:statusBarColor">@color/background_light</item>
        <item name="android:navigationBarColor">@color/background_light</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="Theme.LiasRemote.Splash">
        <item name="android:windowBackground">@color/background_light</item>
    </style>
</resources>
